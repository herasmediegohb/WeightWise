# Postgres connection string (Supabase or Neon). Leave unset for local
# development: the app then uses an embedded database stored in ./.data
DATABASE_URL=

# Password for signing in. Required in production; the app stays locked without it.
APP_PASSWORD=

# Optional: signs the session cookie. Defaults to a value derived from APP_PASSWORD.
AUTH_SECRET=

# Enables food estimates from text and photos, the coach chat and AI check-ins.
ANTHROPIC_API_KEY=

# Optional: override the model used for AI features.
# ANTHROPIC_MODEL=claude-opus-5-5
